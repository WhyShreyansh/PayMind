# --- Database (Supabase Postgres) ---
# Used by the app (via @supabase/supabase-js) and by scripts/seed.ts (via `pg`).
# In Supabase: Project Settings -> Database -> Connection string (URI, "Session" mode).
DATABASE_URL=postgres://postgres:password@db.your-project.supabase.co:5432/postgres

# Public Supabase client config (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase service role key — NEVER expose to the browser.
# Used for privileged server-side operations (webhook writes, admin queries).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# Server-only. Used by the "Ask PayMind" AI assistant and recommendation engine.
GEMINI_API_KEY=sk-...
# Optional: override the model used for Ask PayMind (defaults to gpt-4o-mini).
PAYMIND_AI_MODEL=gemini-3.1-flash-lite

# --- Razorpay (Test Mode) ---
# Server-only secret. Used to create Payment Links and verify webhook signatures.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
